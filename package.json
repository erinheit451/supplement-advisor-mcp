{
  "name": "supplement-advisor-mcp",
  "version": "2.0.0",
  "mcpName": "com.verifiedsupplementdata/supplement-advisor-mcp",
  "description": "MCP server providing evidence-based supplement recommendations. Fetches the live catalog from verifiedsupplementdata.com (116 supplement categories, 730 products) with an offline fallback, so prices and availability are never stale. Medication interaction checking, form comparison, and dosage guidance. Data from NIH DSLD, PubMed, NSF, and USP.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "supplement-advisor-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "supplements",
    "health",
    "nutrition",
    "evidence-based",
    "dietary-supplements",
    "medication-interactions"
  ],
  "homepage": "https://verifiedsupplementdata.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/erinheit451/supplement-advisor-mcp"
  },
  "author": "Verified Supplement Data <hello@verifiedsupplementdata.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "verify": "node scripts/verify.mjs",
    "refresh-catalog": "node scripts/refresh-bundled-catalog.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
